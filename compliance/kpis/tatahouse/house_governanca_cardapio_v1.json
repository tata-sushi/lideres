{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatasushi.tech/contracts/tata-house-governanca/cardapio-v1",
  "title": "Governança → TATÁ House — cardápio do dia v1",
  "description": "Snapshot operacional independente de transporte. Pode ser entregue ao House por qualquer canal autorizado; banco e RPC ficam fora deste contrato.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contrato",
    "versao",
    "tipo",
    "origem",
    "atualizadoEm",
    "data",
    "unidade",
    "principal",
    "guarnicao",
    "salada"
  ],
  "properties": {
    "contrato": {
      "const": "tata-house-governanca"
    },
    "versao": {
      "const": 1
    },
    "tipo": {
      "const": "cardapio.dia"
    },
    "origem": {
      "const": "governanca"
    },
    "atualizadoEm": {
      "type": "string",
      "format": "date-time"
    },
    "data": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "unidade": {
      "type": "string",
      "minLength": 1
    },
    "principal": {
      "type": "string",
      "minLength": 1
    },
    "guarnicao": {
      "type": "string"
    },
    "salada": {
      "type": "string"
    }
  }
}
