{
  "contrato": "tata-house-governanca-readonly",
  "versao": 1,
  "modo": "read-only",
  "origem": "lideres",
  "destino": "tata-house",
  "rpcAllowlist": [
    "tata_plus.refeicoes_relatorio_detalhado"
  ],
  "proibido": [
    "insert",
    "update",
    "delete",
    "upsert",
    "storage mutation",
    "schema mutation",
    "grant mutation",
    "rls mutation",
    "rpc de escrita"
  ],
  "janelaHistoricaDias": 56,
  "minimizacao": {
    "inclui": [
      "data",
      "unidade",
      "status",
      "resumo",
      "principal",
      "custoTotal",
      "desperdicioTotal",
      "avaliacaoMedia",
      "nAvaliacoes",
      "frequencia agregada de principais"
    ],
    "exclui": [
      "comentarios individuais",
      "ids internos",
      "identidade de avaliadores",
      "tokens",
      "sessao",
      "permissoes",
      "credenciais Supabase"
    ]
  },
  "falha": "Se a leitura falhar, nenhuma outra RPC/tabela é tentada e o House continua apenas com sua memória local."
}
