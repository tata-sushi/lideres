{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tatasushi.tech/contracts/tata-house-governanca/v1",
  "title": "TATÁ House × Governança — pacote de avaliações v1",
  "description": "Contrato de fronteira independente de banco ou transporte. O backend só entra depois que este formato estiver promovido e provado.",
  "type": "object",
  "additionalProperties": false,
  "required": ["contrato", "versao", "exportadoEm", "eventos"],
  "properties": {
    "contrato": {
      "const": "tata-house-governanca"
    },
    "versao": {
      "const": 1
    },
    "exportadoEm": {
      "type": "string",
      "format": "date-time"
    },
    "eventos": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/avaliacaoPrato"
      }
    }
  },
  "$defs": {
    "avaliacaoPrato": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "tipo",
        "origem",
        "criadoEm",
        "data",
        "unidade",
        "prato",
        "voto"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "tipo": {
          "const": "avaliacao.prato"
        },
        "origem": {
          "const": "tata-house"
        },
        "criadoEm": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "unidade": {
          "type": "string",
          "minLength": 1
        },
        "prato": {
          "type": "string",
          "minLength": 1
        },
        "voto": {
          "enum": ["bom", "ok", "ruim"]
        },
        "comentario": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  }
}
