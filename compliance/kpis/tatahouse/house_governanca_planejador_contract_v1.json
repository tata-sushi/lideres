{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tata-house-governanca-planejador-v1",
  "title": "TATÁ House × Governança — Planejador V1",
  "oneOf": [
    { "$ref": "#/$defs/contexto" },
    { "$ref": "#/$defs/rascunho" }
  ],
  "$defs": {
    "contexto": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contrato",
        "versao",
        "tipo",
        "origem",
        "correlationId",
        "semanaId",
        "unidadeFonte",
        "unidadeAlvo"
      ],
      "properties": {
        "contrato": { "const": "tata-house-governanca" },
        "versao": { "const": 1 },
        "tipo": { "const": "planejamento.semana.contexto" },
        "origem": { "const": "governanca" },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "semanaId": { "type": "string", "pattern": "^[0-9]{4}-S(0[1-9]|[1-4][0-9]|5[0-3])$" },
        "unidadeFonte": { "type": "string", "minLength": 1, "maxLength": 120 },
        "unidadeAlvo": { "const": "tata-house" }
      }
    },
    "dia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "indice",
        "data",
        "pessoas",
        "principal",
        "guarnicaoFixa",
        "guarnicao",
        "salada",
        "sobremesa"
      ],
      "properties": {
        "indice": { "type": "integer", "minimum": 0, "maximum": 6 },
        "data": { "type": "string", "format": "date" },
        "pessoas": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "principal": { "type": "string", "minLength": 1, "maxLength": 300 },
        "guarnicaoFixa": { "type": "string", "maxLength": 300 },
        "guarnicao": { "type": "string", "maxLength": 500 },
        "salada": { "type": "string", "maxLength": 500 },
        "sobremesa": { "type": "string", "maxLength": 300 }
      }
    },
    "diagnostico": {
      "type": "object",
      "additionalProperties": false,
      "required": ["podeEnviar", "bloqueios", "alertas"],
      "properties": {
        "podeEnviar": { "const": true },
        "bloqueios": { "type": "array", "maxItems": 0 },
        "alertas": {
          "type": "array",
          "maxItems": 50,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        }
      }
    },
    "rascunho": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contrato",
        "versao",
        "tipo",
        "origem",
        "proposalId",
        "correlationId",
        "criadoEm",
        "semanaId",
        "unidadeFonte",
        "unidadeAlvo",
        "dias",
        "diagnostico"
      ],
      "properties": {
        "contrato": { "const": "tata-house-governanca" },
        "versao": { "const": 1 },
        "tipo": { "const": "planejamento.semana.rascunho" },
        "origem": { "const": "tata-house" },
        "proposalId": { "type": "string", "minLength": 1, "maxLength": 180 },
        "correlationId": { "type": "string", "minLength": 1, "maxLength": 160 },
        "criadoEm": { "type": "string", "format": "date-time" },
        "semanaId": { "type": "string", "pattern": "^[0-9]{4}-S(0[1-9]|[1-4][0-9]|5[0-3])$" },
        "unidadeFonte": { "type": "string", "minLength": 1, "maxLength": 120 },
        "unidadeAlvo": { "const": "tata-house" },
        "dias": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "prefixItems": [
            { "$ref": "#/$defs/dia" },
            { "$ref": "#/$defs/dia" },
            { "$ref": "#/$defs/dia" },
            { "$ref": "#/$defs/dia" },
            { "$ref": "#/$defs/dia" },
            { "$ref": "#/$defs/dia" },
            { "$ref": "#/$defs/dia" }
          ],
          "items": false
        },
        "diagnostico": { "$ref": "#/$defs/diagnostico" }
      }
    }
  }
}
